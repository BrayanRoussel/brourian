{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/b_logo.txt",
    "color": {
      "1": "red"
    },
    "padding": {
      "top": 0,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "red",
      "title": "bright_red"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "BROURIAN 0.19",
      "outputColor": "bright_red"
    },
    "break",
    {
      "type": "title",
      "key": "  Usuario",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "key": "  Sistema",
      "keyColor": "red",
      "format": "Debian GNU/Linux 13 (trixie)"
    },
    {
      "type": "kernel",
      "key": "  Kernel",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "  Paquetes",
      "keyColor": "red"
    },
    {
      "type": "shell",
      "key": "  Shell",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "key": "  Terminal",
      "keyColor": "red",
      "format": "kitty"
    },
    {
      "type": "wm",
      "key": "  Entorno",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "  Memoria RAM",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "  Espacio Disco",
      "keyColor": "red"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
